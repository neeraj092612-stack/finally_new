{"id": "planning_market_data_design_portfolio_lock", "label": "portfolio_lock", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L1264", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_market_data_design_cache_only_read_path", "label": "Cache Is the Only Read Path", "file_type": "rationale", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sources push, consumers read; one writer per process; watchlist table is source of truth for tickers; sources never raise into the event loop."}, {"id": "planning_market_data_design_day_change_baseline", "label": "Day Change Baseline (reference_price)", "file_type": "rationale", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L210", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulator uses seed price (process lifetime is the demo day); Massive uses prev_day.close, free in the same snapshot call."}, {"id": "planning_market_data_design_gbm_math", "label": "GBM Price Step with Correlated Normals", "file_type": "rationale", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L494", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cholesky of correlation matrix (tech 0.6, finance 0.5, else 0.3) is always positive definite; random 2-5% events ~every 50s."}, {"id": "planning_market_data_design_g1_massive_timestamp_bug", "label": "G1 Massive sip_timestamp Parsing Bug", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LastTrade has no timestamp field (sip_timestamp in ns); MagicMock tests hid the bug."}, {"id": "planning_market_data_design_g3_removal_race", "label": "G3 Massive Removal Race", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L955", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-read active tickers after the await so an in-flight poll cannot rewrite a removed ticker."}, {"id": "planning_market_data_design_g6_module_router", "label": "G6 Module-Level Router", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "planning_market_data_design_g7_sse_heartbeat", "label": "G7 SSE Keep-Alive Heartbeat", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L1057", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idle proxies and browsers drop silent connections; send ': keep-alive' after 15s without data."}, {"id": "planning_market_data_design_g8_backoff", "label": "G8 Massive Exponential Backoff", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L967", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Double interval per consecutive failure up to 300s so 429/bad key does not log every 15s."}, {"id": "planning_market_data_design_sse_wire_format", "label": "SSE Wire Format /api/stream/prices", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L1041", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each event carries every ticker so the frontend replaces rather than merges; an empty {} signals the last ticker was removed."}, {"id": "planning_market_data_design_massive_poll_interval", "label": "MASSIVE_POLL_INTERVAL env var", "file_type": "concept", "source_file": "planning/MARKET_DATA_DESIGN.md", "source_location": "L1640", "source_url": null, "captur