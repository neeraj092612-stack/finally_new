# Required for AI chat (Phase 3). Without it the app still runs; chat returns llm_error.
OPENROUTER_API_KEY=
# Optional: real market data via Massive (Polygon.io). Leave empty to use the built-in simulator. The full-market snapshot needs a paid Massive plan.
MASSIVE_API_KEY=
# Optional: set to true for deterministic mock LLM responses (tests)
LLM_MOCK=false
